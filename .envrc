# direnv config for AnsibleForge — auto-loads the git-ignored .env when you
# cd into this repo, exporting the vars the committed .mcp.json servers need
# (CONTROLLER_OAUTH_TOKEN for aap, AWS_PROFILE/AWS_REGION for aws-mcp).
# Run `direnv allow` once to trust this file. Contains no secrets — the real
# values live in .env (git-ignored). Safe to commit.
dotenv
