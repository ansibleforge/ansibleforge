# Environment for the committed .mcp.json MCP servers.
# Copy to .env (git-ignored) and fill in real values, then export before
# launching Claude Code:  set -a; source .env; set +a
# (or use direnv, which auto-loads .env per directory).

# --- AAP ---------------------------------------------------------------
# Read/write-scoped gateway OAuth token for the spark AAP cluster. This is
# the SAME variable the CaC playbooks consume (controller_config/dispatch.yml),
# so one token serves both the `aap` MCP server and playbook runs.
# Mint at: POST https://aap-aap.apps.ocp.spark.ansibleforge.dev/api/gateway/v1/tokens/
# Scope note: the MCP server only reads, so a `read`-scoped token is enough
# for MCP alone; use a `write`-scoped token if you also run CaC with it.
CONTROLLER_OAUTH_TOKEN=

# --- AWS ---------------------------------------------------------------
# Named profile from ~/.aws/config|credentials — credentials themselves stay
# in the AWS credential chain, never in this repo.
AWS_PROFILE=ansibleforge
AWS_REGION=us-east-1
# Set to false to allow the AWS MCP server to make mutating calls.
AWS_MCP_READ_ONLY=true
