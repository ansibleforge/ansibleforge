{
  "mcpServers": {
    "aap": {
      "type": "http",
      "url": "https://aap-mcp-aap.apps.ocp.spark.ansibleforge.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTROLLER_OAUTH_TOKEN}"
      }
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.3",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--read-only",
        "--profile", "${AWS_PROFILE:-default}",
        "--metadata", "AWS_REGION=${AWS_REGION:-us-east-1}"
      ]
    }
  }
}
